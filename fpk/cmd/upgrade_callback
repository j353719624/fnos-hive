#!/bin/bash
set -u
# 升级后：与 install_callback 相同（幂等）：刷新托管单元并整体重启
UNIT=/etc/systemd/system/hive-honeypot.service
BIN=/vol2/@appcenter/hive/bin

# 自包含载荷修复：与 install_callback 相同（幂等；轻包无压缩包则跳过）
if [ ! -x "${BIN}/hfish/server" ] && [ -f "${BIN}/hfish.tar.gz" ]; then
  tar -xzf "${BIN}/hfish.tar.gz" -C "${BIN}" && chmod +x "${BIN}/hfish/server"
fi
if [ ! -x "${BIN}/cowrie/venv/bin/twistd" ] && [ -f "${BIN}/cowrie.tar.gz" ]; then
  tar -xzf "${BIN}/cowrie.tar.gz" -C "${BIN}"
fi
# Cowrie 拒绝以 root 运行：统一把目录交给 admin（含旧 root 运行残留的属主文件）
chown -R admin:Users "${BIN}/cowrie" 2>/dev/null || true
chown -R admin:Users /vol2/1000/docker/cowrie 2>/dev/null || true

cat > "$UNIT" <<'EOF'
[Unit]
Description=fnOS Hive honeypot (HFish + Cowrie + proxy)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -x /vol2/@appcenter/hive/bin/start.sh ] && exit 0; sleep 2; done; exit 1'
ExecStart=/bin/bash /vol2/@appcenter/hive/bin/start.sh fg
Restart=always
RestartSec=3
KillMode=control-group

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload 2>/dev/null || true
systemctl enable --now hive-honeypot.service 2>/dev/null || /bin/bash /vol2/@appcenter/hive/bin/start.sh

exit 0
